{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andreischuaste12-ctrl/hacker-code-konvert/schemas/run.schema.json",
  "title": "Hacker Code Konvert Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "duration_ms",
    "analysis_profile",
    "scope",
    "vulnerability_scan_performed",
    "controls",
    "limits",
    "inventory",
    "scanner",
    "limitations",
    "complete"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_profile": {
      "const": "repository"
    },
    "scope": {
      "type": "object"
    },
    "controls": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "inventory": {
      "type": "object"
    },
    "scanner": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "enum": [
            "inventory",
            "semgrep",
            "gitleaks",
            "osv-scanner"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "partial_coverage",
            "unavailable",
            "failed",
            "timeout",
            "output_limited",
            "malformed_output",
            "invalid_findings"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_scanned": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "files_submitted": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "coverage": {
          "type": "object"
        },
        "sandbox": {
          "type": "object"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "complete": {
      "type": "boolean"
    },
    "vulnerability_scan_performed": {
      "type": "boolean"
    },
    "rules_applied": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        }
      }
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
